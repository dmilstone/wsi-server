#!/bin/zsh

set -u

usage() {
    echo "Usage: wsi {production|staging|development} {start|stop|status|logs}"
    exit 2
}

[[ $# -eq 2 ]] || usage

ENVIRONMENT="$1"
ACTION="$2"

case "$ENVIRONMENT" in
    production)
        NAME="Production"
        PORT="8080"
        BASE="${WSI_PRODUCTION_ROOT:-/Users/dm026/wsi-server-production}"
        CONFIG_DIR="$BASE/config"
        LOG_FILE="$BASE/logs/production.log"
        PID_FILE="$BASE/run/production.pid"
        LAUNCHER_PID_FILE="$BASE/run/production-launcher.pid"
        JAR="$BASE/app/wsi-server.jar"
        MODE="jar"
        ;;
    staging)
        NAME="Staging"
        PORT="8082"
        BASE="${WSI_STAGING_ROOT:-/Users/dm026/wsi-staging}"
        CONFIG_DIR="$BASE/config"
        LOG_FILE="$BASE/logs/staging.log"
        PID_FILE="$BASE/run/staging.pid"
        LAUNCHER_PID_FILE="$BASE/run/staging-launcher.pid"
        JAR="$BASE/app/wsi-server.jar"
        MODE="jar"
        ;;
    development)
        NAME="Development"
        PORT="8081"
        SOURCE_DIR="${WSI_REPO:-/Users/dm026/Downloads/wsi-server_works}"
        BASE="${WSI_DEVELOPMENT_ROOT:-$SOURCE_DIR/.runtime}"
        CONFIG_DIR="$BASE/config"
        LOG_FILE="$BASE/logs/development.log"
        PID_FILE="$BASE/run/development.pid"
        LAUNCHER_PID_FILE="$BASE/run/development-launcher.pid"
        MODE="maven"
        ;;
    *)
        usage
        ;;
esac

listener_pid() {
    lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -n 1
}

show_status() {
    PID="$(listener_pid)"

    if [[ -n "$PID" ]]; then
        echo "$NAME is RUNNING"
        echo "Port: $PORT"
        echo "PID:  $PID"
        ps -p "$PID" -o pid=,etime=,comm=
    else
        echo "$NAME is STOPPED"
        echo "Port: $PORT"
    fi

    if [[ "$MODE" = "jar" && -f "$BASE/app/BUILD_TAG.txt" ]]; then
        echo "Build:  $(cat "$BASE/app/BUILD_TAG.txt")"
    fi

    if [[ "$MODE" = "jar" && -f "$BASE/app/BUILD_COMMIT.txt" ]]; then
        echo "Commit: $(cat "$BASE/app/BUILD_COMMIT.txt")"
    fi
}

start_server() {
    EXISTING_PID="$(listener_pid)"

    if [[ -n "$EXISTING_PID" ]]; then
        echo "$NAME is already running on port $PORT with PID $EXISTING_PID."
        exit 0
    fi

    mkdir -p "$BASE/logs" "$BASE/run"

    if [[ ! -f "$CONFIG_DIR/application.properties" ]]; then
        echo "Configuration not found:"
        echo "$CONFIG_DIR/application.properties"
        exit 1
    fi

    if [[ "$MODE" = "jar" ]]; then
        if [[ ! -f "$JAR" ]]; then
            echo "JAR not found:"
            echo "$JAR"
            exit 1
        fi

        cd "$BASE" || exit 1
        nohup /usr/bin/java -jar "$JAR" \
            "--spring.config.additional-location=file:$CONFIG_DIR/" \
            > "$LOG_FILE" 2>&1 < /dev/null &
        LAUNCHER_PID="$!"
    else
        cd "$SOURCE_DIR" || exit 1
        nohup ./mvnw spring-boot:run \
            -Dspring-boot.run.arguments="--spring.config.additional-location=file:$CONFIG_DIR/" \
            > "$LOG_FILE" 2>&1 < /dev/null &
        LAUNCHER_PID="$!"
    fi

    echo "$LAUNCHER_PID" > "$LAUNCHER_PID_FILE"
    echo "Starting $NAME..."

    ATTEMPT=0
    while [[ "$ATTEMPT" -lt 30 ]]; do
        sleep 1
        PID="$(listener_pid)"
        if [[ -n "$PID" ]]; then
            echo "$PID" > "$PID_FILE"
            echo "$NAME started successfully."
            echo "Port: $PORT"
            echo "PID:  $PID"
            exit 0
        fi
        ATTEMPT=$((ATTEMPT + 1))
    done

    echo "$NAME did not begin listening on port $PORT."
    echo "Recent log output:"
    tail -n 60 "$LOG_FILE"
    exit 1
}

stop_server() {
    PID="$(listener_pid)"

    if [[ -z "$PID" ]]; then
        echo "$NAME is already stopped."
        rm -f "$PID_FILE" "$LAUNCHER_PID_FILE"
        exit 0
    fi

    echo "Stopping $NAME with PID $PID..."
    kill "$PID"

    ATTEMPT=0
    while [[ "$ATTEMPT" -lt 20 ]]; do
        sleep 1
        if [[ -z "$(listener_pid)" ]]; then
            if [[ -f "$LAUNCHER_PID_FILE" ]]; then
                LAUNCHER_PID="$(cat "$LAUNCHER_PID_FILE")"
                if [[ "$LAUNCHER_PID" != "$PID" ]] && kill -0 "$LAUNCHER_PID" 2>/dev/null; then
                    kill "$LAUNCHER_PID" 2>/dev/null
                fi
            fi
            rm -f "$PID_FILE" "$LAUNCHER_PID_FILE"
            echo "$NAME stopped."
            exit 0
        fi
        ATTEMPT=$((ATTEMPT + 1))
    done

    echo "$NAME is still listening on port $PORT."
    echo "No forced termination was attempted."
    exit 1
}

show_logs() {
    mkdir -p "$BASE/logs"
    touch "$LOG_FILE"
    echo "Following $LOG_FILE"
    echo "Press Control-C to stop following the log."
    tail -n 100 -f "$LOG_FILE"
}

case "$ACTION" in
    start) start_server ;;
    stop) stop_server ;;
    status) show_status ;;
    logs) show_logs ;;
    *) usage ;;
esac
